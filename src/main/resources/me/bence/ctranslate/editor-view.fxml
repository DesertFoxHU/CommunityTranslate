<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="me.bence.ctranslate.EditorController">
    <top>
        <ToolBar>
            <MenuButton fx:id="recentMenu" text="Recent projects"/>
            <Button text="Open Source" onAction="#onOpenSource"/>
            <Button text="Open Translation" onAction="#onOpenTarget"/>
            <Button text="Save" onAction="#onSave"/>
            <Separator/>
            <TextField fx:id="searchField" promptText="Search..." prefWidth="250"/>
            <ComboBox fx:id="statusFilter" prefWidth="140"/>
        </ToolBar>
    </top>

    <center>
        <TableView fx:id="table" editable="true">
            <columns>
                <TableColumn fx:id="keyColumn" text="Key" prefWidth="250"/>
                <TableColumn fx:id="sourceColumn" text="Source" prefWidth="350"/>
                <TableColumn fx:id="translationColumn" text="Translation" prefWidth="350"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="20">
            <padding>
                <Insets top="5" right="10" bottom="5" left="10"/>
            </padding>
            <Label fx:id="fileLabel" text="There isn't an opened file"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="progressLabel"/>
        </HBox>
    </bottom>
</BorderPane>